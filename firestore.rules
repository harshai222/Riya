rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == '3881229harsh@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Follow Relationships
    match /follows/{relId} {
      allow read, write: if isSignedIn();
    }

    // 2. Follow Requests
    match /followRequests/{reqId} {
      allow read, write: if isSignedIn();
    }

    // 3. Conversations (Direct / Group chats with participant authorization)
    match /conversations/{convId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.participantIds ||
        (request.resource != null && request.auth.uid in request.resource.data.participantIds)
      );

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    // 4. User Profiles & Subcollections (memories, conversations, notifications)
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn();
    }

    // 5. Globally Unique Usernames Registry
    match /usernames/{usernameNormalized} {
      allow read, write: if isSignedIn();
    }

    // 6. Public UID Uniqueness Index
    match /publicUids/{publicUid} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 7. System Config & Admin Settings (Accessible for server and admin configuration)
    match /systemConfig/{document=**} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /system/{document=**} {
      allow read, write: if true;
    }

    // 8. Presence Tracking
    match /presence/{userId} {
      allow read, write: if isSignedIn();
    }

    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
