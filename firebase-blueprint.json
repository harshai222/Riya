{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with Google account info, unique username, and personality settings for Riya",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The Firebase Authentication UID"
        },
        "publicUid": {
          "type": "string",
          "description": "10-11 digit numeric unique public identifier"
        },
        "username": {
          "type": "string",
          "description": "Unique chosen username"
        },
        "usernameNormalized": {
          "type": "string",
          "description": "Lowercase normalized unique username for uniqueness checks"
        },
        "displayName": {
          "type": "string",
          "description": "Google display name"
        },
        "email": {
          "type": "string",
          "description": "Google account email"
        },
        "photoURL": {
          "type": "string",
          "description": "Google profile photo URL"
        },
        "preferredName": {
          "type": "string",
          "description": "What Riya calls the user"
        },
        "favoriteVibe": {
          "type": "string",
          "description": "Favorite ambient aura"
        },
        "bio": {
          "type": "string",
          "description": "User bio or facts summary"
        },
        "role": {
          "type": "string",
          "description": "User role: user or admin"
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether the user has completed username onboarding"
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Last Google login timestamp"
        },
        "accountType": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Account privacy setting"
        },
        "followersCount": {
          "type": "number",
          "description": "Total followers"
        },
        "followingCount": {
          "type": "number",
          "description": "Total following"
        }
      },
      "required": ["uid", "publicUid", "createdAt", "lastLoginAt", "accountType"]
    },
    "FollowRelationship": {
      "title": "FollowRelationship",
      "description": "Active follow relationship between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "followerUid": { "type": "string" },
        "followingUid": { "type": "string" },
        "status": { "type": "string", "enum": ["following"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "followerUid", "followingUid", "status", "createdAt"]
    },
    "FollowRequest": {
      "title": "FollowRequest",
      "description": "Pending follow request for private accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderUid": { "type": "string" },
        "receiverUid": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "senderUid", "receiverUid", "status", "createdAt"]
    },
    "ChatConversation": {
      "title": "ChatConversation",
      "description": "A 1-to-1 chat session between two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantIds": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "unreadCount": { "type": "object", "description": "Map of userId to unread count" }
      },
      "required": ["id", "participantIds", "lastMessageAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "An individual message in a social chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "video"] },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "storagePath": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "conversationId", "senderId", "type", "createdAt"]
    },
    "SocialNotification": {
      "title": "SocialNotification",
      "description": "User notification for social events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["follow_request", "follow_accept", "new_message"] },
        "fromUid": { "type": "string" },
        "fromUsername": { "type": "string" },
        "relatedId": { "type": "string", "description": "e.g., requestId or conversationId" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "fromUid", "read", "createdAt"]
    },
    "PublicUidReservation": {
      "title": "PublicUidReservation",
      "description": "Index entry for public numeric UID uniqueness",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "createdAt"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Global unique username registry entry mapped to Firebase UID",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner Firebase UID"
        },
        "username": {
          "type": "string",
          "description": "Original case-preserved username"
        },
        "usernameNormalized": {
          "type": "string",
          "description": "Normalized lowercase username key"
        },
        "createdAt": {
          "type": "string",
          "description": "Reservation timestamp"
        }
      },
      "required": ["uid", "username", "usernameNormalized", "createdAt"]
    },
    "MemoryFact": {
      "title": "MemoryFact",
      "description": "Atomic facts and preferences remembered by Riya from past chats",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID"
        },
        "category": {
          "type": "string",
          "description": "Category like preference, work, hobby, relationship"
        },
        "fact": {
          "type": "string",
          "description": "The specific memory fact"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "category", "fact", "createdAt"]
    },
    "ConversationSession": {
      "title": "ConversationSession",
      "description": "Recap and metadata of voice conversations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Session conversation ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID"
        },
        "summary": {
          "type": "string",
          "description": "Short recap of conversation"
        },
        "vibeUsed": {
          "type": "string",
          "description": "Ambient vibe during session"
        },
        "highlights": {
          "type": "string",
          "description": "Key memorable banter moments"
        },
        "messageCount": {
          "type": "number",
          "description": "Number of dialog turns in this session"
        },
        "createdAt": {
          "type": "string",
          "description": "Session creation time"
        }
      },
      "required": ["id", "userId", "summary", "createdAt"]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "Individual speech turn message in a conversation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Message ID"
        },
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID"
        },
        "speaker": {
          "type": "string",
          "description": "user or riya"
        },
        "text": {
          "type": "string",
          "description": "Transcribed speech content"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of utterance"
        }
      },
      "required": ["id", "conversationId", "userId", "speaker", "text", "createdAt"]
    },
    "GeminiConfig": {
      "title": "GeminiConfig",
      "description": "Centralized Gemini API configuration including the protected API key.",
      "type": "object",
      "properties": {
        "apiKey": {
          "type": "string",
          "description": "Privileged Gemini API Key (Masked in UI)"
        },
        "activeModel": {
          "type": "string",
          "description": "Currently active Gemini model name"
        },
        "activeVoice": {
          "type": "string",
          "description": "Currently active prebuilt voice name"
        },
        "version": {
          "type": "number",
          "description": "Configuration version number"
        },
        "status": {
          "type": "string",
          "description": "active, invalid, or maintenance"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["activeModel", "activeVoice", "version", "updatedAt"]
    }
  },
  "firestore": {
    "/usernames/{usernameNormalized}": {
      "schema": "UsernameReservation",
      "description": "Global unique username lookup registry"
    },
    "/publicUids/{publicUid}": {
      "schema": "PublicUidReservation",
      "description": "Uniqueness index for numeric public UIDs"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user profile"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "SocialNotification",
      "description": "User social notifications"
    },
    "/follows/{relationshipId}": {
      "schema": "FollowRelationship",
      "description": "Active follow records"
    },
    "/followRequests/{requestId}": {
      "schema": "FollowRequest",
      "description": "Pending follow requests"
    },
    "/conversations/{conversationId}": {
      "schema": "ChatConversation",
      "description": "Active chat threads"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages inside chats"
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": "MemoryFact",
      "description": "Subcollection of remembered facts and preferences for this user"
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": "ConversationSession",
      "description": "Subcollection of past voice conversations"
    },
    "/users/{userId}/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ConversationMessage",
      "description": "Subcollection of messages inside a conversation session"
    },
    "/systemConfig/gemini": {
      "schema": "GeminiConfig",
      "description": "CENTRAL CONFIGURATION: Contains the active Gemini API Key and model settings. Restricted to Admin."
    }
  }
}
